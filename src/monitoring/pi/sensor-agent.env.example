# Environment file for the sensor-agent systemd service on the Raspberry Pi.
# Copy to /etc/sensor-agent.env (root-owned, mode 600 is fine) and edit the
# host/port below to match your control PC. Never commit a real copy of this
# file with your lab's actual network details.

# Hostname or IP address of the control PC running the dashboard.
# Required — the agent refuses to start without it.
SENSOR_AGENT_PC_HOST=192.0.2.1

# TCP port the dashboard listens on for sensor data.
# Must match `sensor_dashboard.tcp_port` in src/monitoring/config.yaml on the PC.
SENSOR_AGENT_PC_PORT=50001

# Optional: seconds between samples (default 0.1 if unset).
#SENSOR_AGENT_INTERVAL_S=0.1

# Optional: shared secret sent as the first line of every connection. Must equal
# SENSOR_DASHBOARD_PI_TOKEN on the PC; leave unset if the PC sets no token.
#SENSOR_AGENT_TOKEN=change-me
