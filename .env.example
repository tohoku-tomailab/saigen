# Copy this file to .env and fill in your own values. Never commit .env.

# ---- AI agent (src/agent/llm_service.py) --------------------------------------
# Backend for experimental-flow generation: "gemini" (default) or "openai_compatible"
LLM_MODE=gemini

# Google Gemini API (LLM_MODE=gemini). Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Any OpenAI-compatible endpoint (LLM_MODE=openai_compatible), e.g. a local inference
# server. LLM_API_KEY may be a dummy value if the server does not check it.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- Device ports: OPTIONAL per-run overrides ----------------------------------
# The ports and the robot workspace limits live in config.yaml (copy
# config.example.yaml to config.yaml and edit it). The variables below only
# override that file for processes started with this .env; a command-line flag
# such as --robot1-dobot overrides both.
#   resolution order:  CLI flag  >  .env  >  config.yaml  >  built-in defaults
# COM ports on Windows (COM3, COM12, ...), /dev/tty* on Linux/macOS.
ROBOT1_DOBOT_PORT=
ROBOT1_PICUS2_PORT=
ROBOT2_DOBOT_PORT=
ROBOT2_PICUS2_PORT=
ROBOT3_DOBOT_PORT=
# Robot 4 is the optional Hiwonder MaxArm (type: maxarm in config.yaml)
ROBOT4_MAXARM_PORT=
SCALE_PORT=
CAMERA_INDEX=0
MICROSCOPE_INDEX=
MICROSCOPE_PORT=
# Keithley 2002 DMM: VISA resource string, e.g. GPIB0::16::INSTR
DMM_RESOURCE=
# NF LI5640 lock-in amplifier: VISA resource string, e.g. GPIB0::<address>::INSTR
LOCKIN_RESOURCE=

# ---- Monitoring (src/monitoring/) ---------------------------------------------
# URL of the sensor dashboard the GUI talks to for start/stop of recording
SENSOR_SERVER_URL=http://localhost:8000
# On the Raspberry Pi agent: IP of the control PC and TCP port of the dashboard
# (example address only — replace with your control PC's real LAN IP; this
# corresponds to SENSOR_AGENT_PC_HOST in src/monitoring/pi/sensor-agent.env.example)
SENSOR_PC_IP=192.0.2.1
SENSOR_TCP_PORT=50001

# Dashboard web server bind address; keep 127.0.0.1 unless a browser on another machine needs access
SENSOR_DASHBOARD_HOST=127.0.0.1
# Shared secret required (as an X-Auth-Token header) for /api/start and /api/end once set
SENSOR_DASHBOARD_TOKEN=
# Comma-separated extra Host headers to allow (DNS-rebinding protection), needed if SENSOR_DASHBOARD_HOST is not 127.0.0.1
SENSOR_DASHBOARD_ALLOWED_HOSTS=
# Override for the CSV/video output directory; default is experiment_data/ under the repo root
SENSOR_DASHBOARD_DATA_DIR=

# ---- Imaging (src/imaging/) -----------------------------------------------------
# Optional: pick one NEEWER light when several are in range (BLE address / device id)
NEEWER_DEVICE_ID=

# ---- Other ----------------------------------------------------------------------
OPENAI_API_KEY=
