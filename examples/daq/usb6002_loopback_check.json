{
  "name": "daq_usb6002_loopback_check",
  "description": "BENCH CHECK of the outputs of a USB-6002, by loop-back: every output is wired straight back to an input of the same board and nothing else is connected. Jumpers: AO0-AI0, AO0-PFI0 (a second wire from AO0), AO1-AI1, P0.0-P0.1. The board has no pulse-train output, so its own analog output, as a 0-5 V square wave, is the signal for the counter and for the digital trigger. It runs only after the human has enabled ao0, ao1 and port0/line0 in config.yaml for the check, with daq_model: USB-6002 (see examples/daq/README.md, which also lists the reading each step should give). None of these outputs had been driven on a device when this was written: if DAQmx refuses a step the flow stops there and the outputs are reset.",
  "steps": [
    {"action": "daq_write_analog", "channel": "ao0", "voltage": 2.5},
    {"action": "daq_read_analog", "channel": "ai0", "terminal": "rse"},
    {"action": "daq_write_analog", "channel": "ao0", "voltage": 1.0},
    {"action": "daq_read_analog", "channel": "ai0", "terminal": "rse"},
    {"action": "daq_stop_output", "channel": "ao0"},
    {"action": "daq_read_analog", "channel": "ai0", "terminal": "rse"},

    {"action": "daq_generate_waveform", "channel": "ao0", "waveform": "sine", "frequency_hz": 10.0, "amplitude_v": 1.0, "offset_v": 2.0},
    {"action": "daq_acquire", "channels": ["ai0"], "rate_hz": 5000.0, "duration_s": 0.5, "terminal": "rse"},
    {"action": "daq_stop_output", "channel": "ao0"},
    {"action": "daq_read_analog", "channel": "ai0", "terminal": "rse"},

    {"action": "daq_write_digital", "line": "port0/line0", "state": true},
    {"action": "daq_read_digital", "line": "port0/line1"},
    {"action": "daq_write_digital", "line": "port0/line0", "state": false},
    {"action": "daq_read_digital", "line": "port0/line1"},
    {"action": "daq_pulse_digital", "line": "port0/line0", "duration_s": 0.2},
    {"action": "daq_read_digital", "line": "port0/line1"},

    {"action": "daq_generate_waveform", "channel": "ao0", "waveform": "square", "frequency_hz": 50.0, "amplitude_v": 2.5, "offset_v": 2.5},
    {"action": "daq_count_edges", "terminal": "pfi0", "duration_s": 2.0},
    {"action": "daq_acquire", "channels": ["ai0"], "rate_hz": 5000.0, "duration_s": 0.1, "terminal": "rse", "trigger": "pfi0", "trigger_edge": "rising", "timeout_s": 5.0},
    {"action": "daq_stop_output", "channel": "ao0"},
    {"action": "daq_count_edges", "terminal": "pfi0", "duration_s": 1.0},

    {"action": "daq_stimulate_acquire", "channel": "ao0", "waveform": "triangle", "frequency_hz": 10.0, "amplitude_v": 1.0, "offset_v": 2.0, "channels": ["ai0"], "rate_hz": 5000.0, "duration_s": 0.5, "terminal": "rse"},

    {"action": "daq_write_analog", "channel": "ao1", "voltage": 1.5},
    {"action": "daq_generate_waveform", "channel": "ao0", "waveform": "square", "frequency_hz": 10.0, "amplitude_v": 1.0, "offset_v": 2.0},
    {"action": "daq_acquire", "channels": ["ai0", "ai1"], "rate_hz": 2500.0, "duration_s": 0.5, "terminal": "rse"},
    {"action": "daq_stop_output", "channel": "ao0"},
    {"action": "daq_stop_output", "channel": "ao1"},
    {"action": "daq_acquire", "channels": ["ai0", "ai1"], "rate_hz": 1000.0, "duration_s": 0.1, "terminal": "rse"}
  ]
}
