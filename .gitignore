# Secrets — never commit API keys
.env
*.key
credentials*.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Logs and local experiment output
logs/
*.log

# ML weights and training data (not published — see detection/README.md)
detection/weights/
detection/dataset/
*.pt

# CAD temporary/backup files
*.f3d.bak
~$*

# OS / editor
.DS_Store
.idea/
.vscode/

# Imaging system (src/imaging/): per-PC camera selection and local captures
src/imaging/config/camera_local.json
imaging_data/
panels/

# Control core (src/flow/, src/devices/): per-environment ports and workspace
# limits — copy config.example.yaml to config.yaml and edit that
/config.yaml

# CSV runner (src/flow/csv_runner/): the lab's own parameter sheet and the
# results written back beside it — copy control.example.csv to control.csv
src/flow/csv_runner/control.csv
src/flow/csv_runner/results*.csv
# tube-balancing runner: copy balance.example.csv to balance.csv (lab positions)
src/flow/balance_runner/balance.csv
src/flow/balance_runner/results*.csv

# Monitoring (src/monitoring/): per-environment port config, not published
src/monitoring/config.yaml

# Runtime output of flow runs and monitoring
experiment_data/
captured_images/
microscope_images/

# MaxArm firmware backups (contain Hiwonder vendor code) - keep locally, never commit
backups/

# MaxArm taught positions (lab-specific, written by src/devices/maxarm/teach.py)
maxarm_positions*.json
dobot_positions*.json
